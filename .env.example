# =============================================================
# CareerLens Environment Configuration
# =============================================================

# --- LLM Provider ---
# Choose one provider. Set LLM_PROVIDER to: bedrock, anthropic, or openai
LLM_PROVIDER=bedrock

# Option A: AWS Bedrock (default)
AWS_PROFILE=your_aws_profile_name
AWS_DEFAULT_REGION=us-east-1

# Option B: Anthropic (uncomment and set LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Option C: OpenAI (uncomment and set LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key

# Optional: override the default model ID for your chosen provider
# LLM_MODEL_ID=your_model_id

# --- YouTube Data API v3 (free at https://console.cloud.google.com) ---
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# --- Storage ---
CAREERLENS_DATA_DIR=./backend/data
